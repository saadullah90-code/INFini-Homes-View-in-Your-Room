<div
  class="viyr-root"
  id="viyr-root-{{ product.id }}"
  data-viyr-instance
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-image-urls="{{ product.images | map: 'src' | json | escape }}"
  data-shop-domain="{{ shop.permanent_domain }}"
  data-shop-storefront-domain="{{ request.host }}"
>
  <button type="button" class="viyr-button" data-viyr-open hidden>
    <svg class="viyr-button__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path fill="currentColor" d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3 6.5 3.6-6.5 3.6-6.5-3.6L12 4.3ZM5 9.6l6 3.3v7.1l-6-3.3V9.6Zm8 10.4v-7.1l6-3.3v7.1l-6 3.3Z"/>
    </svg>
    <span data-viyr-button-label>Check Size &amp; Room Fit</span>
  </button>

  <div class="viyr-modal" data-viyr-modal hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="View in Your Room">
    <div class="viyr-modal__backdrop" data-viyr-close></div>
    <div class="viyr-modal__panel">
      <button type="button" class="viyr-modal__close" data-viyr-close aria-label="Close">&times;</button>

      <div class="viyr-modal__body">
        <div class="viyr-viewer-wrap" data-viyr-viewer-wrap>
          <img class="viyr-product-image" data-viyr-product-image hidden alt="{{ product.title | escape }} — product image" draggable="false">
          <div class="viyr-state viyr-state--loading" data-viyr-loading>
            <div class="viyr-spinner" aria-hidden="true"></div>
            <p>Loading 3D model…</p>
          </div>
          <div class="viyr-state viyr-state--error" data-viyr-error hidden>
            <p data-viyr-error-message>We couldn't load the 3D model right now. Please try again in a moment.</p>
            <button type="button" class="viyr-retry-btn" data-viyr-retry hidden>Retry</button>
          </div>
        </div>

        <div class="viyr-side">
          <h3 class="viyr-side__title" data-viyr-title>&nbsp;</h3>
          <p class="viyr-side__hint" data-viyr-hint>Drag to rotate &middot; Pinch or scroll to zoom</p>
          <p class="viyr-side__dimensions" data-viyr-dimensions hidden></p>
          <p class="viyr-side__notice" data-viyr-model-notice hidden></p>
          <p class="viyr-side__notice" data-viyr-size-note hidden></p>

          <button type="button" class="viyr-ar-btn" data-viyr-ar-btn hidden disabled>
            View in your space (AR)
          </button>
          <p class="viyr-ar-note" data-viyr-ar-note hidden role="status" aria-live="polite"></p>
          <button type="button" class="viyr-qr-btn" data-viyr-start-camera hidden>Start camera (2D image overlay)</button>

          <button type="button" class="viyr-qr-btn" data-viyr-size-open>Enter your dimensions</button>
          <button type="button" class="viyr-qr-btn" data-viyr-qr-btn hidden aria-expanded="false" aria-controls="viyr-qr-{{ product.id }}">Show QR code</button>
          <div class="viyr-qr" id="viyr-qr-{{ product.id }}" data-viyr-qr-wrap hidden>
            <p class="viyr-qr__label">Scan with your phone for AR</p>
            <div data-viyr-qr-canvas class="viyr-qr__canvas"></div>
            <p class="viyr-qr__fallback" data-viyr-qr-fallback hidden>
              QR code unavailable — open this page on your phone instead.
            </p>
          </div>
        </div>
      </div>
      <section class="viyr-fit" data-viyr-fit hidden aria-label="Product size and room fit calculator">
        <button type="button" class="viyr-qr-btn" data-viyr-size-back>← Back to preview and QR</button>
        <h3>Enter your dimensions</h3>
        <p>Compare your product with your wall, floor, or both. Measurements are in cm; no dimensions are estimated from the image.</p>
        <label for="viyr-size-choice-{{ product.id }}">Product size</label>
        <select id="viyr-size-choice-{{ product.id }}" data-viyr-size-choice>
          {% for option in product.options_with_values %}
            {% assign size_option_name = option.name | downcase %}
            {% if size_option_name contains 'size' or size_option_name contains 'dimension' %}
              {% for value in option.values %}
                <option value="shopify:{{ value | escape }}">Shopify size: {{ value | escape }}</option>
              {% endfor %}
            {% endif %}
          {% endfor %}
          <option value="custom">Custom size (planning only)</option>
        </select>
        <p class="viyr-fit__note" data-viyr-size-source>Enter the product's real measurements below. Shopify size labels alone do not tell us width, depth and height.</p>
        <div class="viyr-fit__fields">
          <label>Product width <input data-viyr-product-width type="number" inputmode="decimal" min="0.1" max="100000" step="0.1" placeholder="cm"></label>
          <label>Product depth <input data-viyr-product-depth type="number" inputmode="decimal" min="0.1" max="100000" step="0.1" placeholder="cm"></label>
          <label>Product height <input data-viyr-product-height type="number" inputmode="decimal" min="0.1" max="100000" step="0.1" placeholder="cm"></label>
        </div>
        <div class="viyr-fit__spaces">
          <fieldset>
            <legend>Your wall (optional)</legend>
            <div class="viyr-fit__fields">
              <label>Wall width <input data-viyr-wall-width type="number" inputmode="decimal" min="0.1" max="100000" step="0.1" placeholder="cm"></label>
              <label>Wall height <input data-viyr-wall-height type="number" inputmode="decimal" min="0.1" max="100000" step="0.1" placeholder="cm"></label>
            </div>
          </fieldset>
          <fieldset>
            <legend>Your floor / room (optional)</legend>
            <div class="viyr-fit__fields">
              <label>Floor width <input data-viyr-floor-width type="number" inputmode="decimal" min="0.1" max="100000" step="0.1" placeholder="cm"></label>
              <label>Floor depth <input data-viyr-floor-depth type="number" inputmode="decimal" min="0.1" max="100000" step="0.1" placeholder="cm"></label>
              <label>Gap behind product <input data-viyr-back-gap type="number" inputmode="decimal" min="0" max="100000" step="0.1" value="0"></label>
            </div>
          </fieldset>
        </div>
        <div class="viyr-fit__result" data-viyr-fit-result role="status" aria-live="polite"></div>
        <p class="viyr-fit__note">Remaining width assumes centered placement. Back gap must be entered; wall width cannot determine it. Floor depth remaining is the space <strong>in front</strong> of the product. Allow extra clearance for doors, drawers and walking. A custom size is not an order or confirmed available variant. Camera/image preview is not to scale.</p>
      </section>
    </div>
  </div>

  <div class="viyr-camera-stage" data-viyr-camera-stage hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Camera image preview">
    <video class="viyr-camera-video" data-viyr-camera-video autoplay muted playsinline hidden aria-label="Live room camera"></video>
    <img class="viyr-product-image" data-viyr-camera-image alt="{{ product.title | escape }} — 2D overlay" draggable="false">
    <button type="button" class="viyr-camera-stage__back" data-viyr-stop-camera>← Back to preview</button>
    <div class="viyr-camera-stage__controls">
      <p data-viyr-camera-note role="status" aria-live="polite"></p>
      <button type="button" class="viyr-qr-btn" data-viyr-camera-retry hidden>Try camera again</button>
      <label class="viyr-image-size" data-viyr-image-size-wrap>Visual image size
        <input type="range" data-viyr-image-size min="50" max="180" value="100">
      </label>
    </div>
  </div>
  <pre class="viyr-debug" data-viyr-debug hidden></pre>
</div>

<style>
  .viyr-root { all: initial; display: block; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  .viyr-root *, .viyr-root *::before, .viyr-root *::after { box-sizing: border-box; }

  .viyr-button {
    display: inline-flex; align-items: center; gap: 8px;
    margin: 12px 0; padding: 12px 20px;
    background: #111827; color: #ffffff; border: none; border-radius: 999px;
    font-size: 15px; font-weight: 600; line-height: 1; cursor: pointer;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }
  .viyr-button:hover { background: #1f2937; }
  .viyr-button:active { transform: scale(0.98); }
  .viyr-button[hidden] { display: none; }
  .viyr-button__icon { flex: none; }

  .viyr-modal {
    position: fixed; inset: 0; z-index: 2147483000;
    display: flex; align-items: center; justify-content: center;
  }
  .viyr-modal[hidden] { display: none; }
  .viyr-modal__backdrop {
    position: absolute; inset: 0; background: rgba(17, 24, 39, 0.6);
  }
  .viyr-modal__panel {
    position: relative; z-index: 1;
    width: min(920px, 94vw); max-height: 90vh; overflow: hidden;
    background: #ffffff; border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    display: flex; flex-direction: column;
  }
  .viyr-modal__close {
    position: absolute; top: 10px; right: 12px; z-index: 2;
    width: 36px; height: 36px; border-radius: 999px; border: none;
    background: rgba(255,255,255,0.9); color: #111827;
    font-size: 22px; line-height: 1; cursor: pointer;
  }
  .viyr-modal__body {
    display: flex; flex-direction: column; height: 100%;
  }
  .viyr-modal__body[hidden] { display: none; }
  @media (min-width: 720px) {
    .viyr-modal__body { flex-direction: row; }
  }

  .viyr-viewer-wrap {
    position: relative; flex: 1 1 60%;
    min-height: 320px; background: #f3f4f6;
  }
  .viyr-viewer-wrap model-viewer { width: 100%; height: 100%; min-height: 320px; --poster-color: transparent; }
  .viyr-viewer-wrap model-viewer[hidden] { display: none; }
  .viyr-camera-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .viyr-camera-stage { position: fixed; inset: 0; z-index: 2147483001; background: #111; color: #fff; }
  .viyr-camera-stage[hidden] { display: none; }
  .viyr-camera-stage .viyr-product-image { z-index: 1; }
  .viyr-camera-stage__back { position: absolute; z-index: 2; top: max(16px, env(safe-area-inset-top)); left: 16px; padding: 12px 16px; border: 0; border-radius: 8px; background: #fff; color: #111827; font-size: 14px; font-weight: 600; }
  .viyr-camera-stage__controls { position: absolute; z-index: 2; bottom: max(16px, env(safe-area-inset-bottom)); left: 16px; right: 16px; padding: 12px; border-radius: 12px; background: rgba(17,24,39,.82); font-size: 12px; }
  .viyr-camera-stage__controls p { margin: 0 0 8px; }
  .viyr-camera-stage__controls .viyr-qr-btn { margin: 0 0 8px; }
  .viyr-camera-stage .viyr-image-size { color: #fff; }
  .viyr-product-image {
    position: absolute; top: 50%; left: 50%; max-width: 86%; max-height: 86%;
    width: auto; height: auto; object-fit: contain; cursor: grab; touch-action: none;
    user-select: none; -webkit-user-drag: none;
    transform: translate(-50%, -50%) translate(var(--move-x, 0px), var(--move-y, 0px)) scale(var(--size, 1));
    filter: drop-shadow(0 7px 8px rgba(0,0,0,.18));
  }
  .viyr-product-image:active { cursor: grabbing; }
  .viyr-camera-video[hidden], .viyr-product-image[hidden] { display: none; }
  .viyr-image-size { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: #4b5563; }
  .viyr-image-size[hidden] { display: none; }
  .viyr-image-size input { width: 180px; max-width: 100%; }

  .viyr-state {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 10px;
    color: #4b5563; font-size: 14px; text-align: center; padding: 20px;
  }
  .viyr-state[hidden] { display: none; }
  .viyr-spinner {
    width: 32px; height: 32px; border-radius: 999px;
    border: 3px solid #e5e7eb; border-top-color: #111827;
    animation: viyr-spin 0.8s linear infinite;
  }
  @keyframes viyr-spin { to { transform: rotate(360deg); } }

  .viyr-side {
    flex: 1 1 40%; padding: 20px 24px 24px; overflow-y: auto;
    display: flex; flex-direction: column;
  }
  .viyr-side__title { margin: 0 0 4px; font-size: 18px; font-weight: 700; color: #111827; }
  .viyr-side__hint { margin: 0 0 16px; font-size: 13px; color: #6b7280; }
  .viyr-side__dimensions { margin: 0 0 6px; font-size: 14px; font-weight: 600; color: #111827; }
  .viyr-side__notice { margin: 0 0 10px; font-size: 12px; line-height: 1.4; color: #4b5563; }
  .viyr-side__dimensions[hidden], .viyr-side__notice[hidden] { display: none; }
  .viyr-retry-btn, .viyr-qr-btn {
    padding: 10px 16px; border: 1px solid #111827; border-radius: 8px;
    background: #fff; color: #111827; font-size: 14px; font-weight: 600; cursor: pointer;
  }
  .viyr-retry-btn[hidden], .viyr-qr-btn[hidden] { display: none; }
  .viyr-qr-btn { align-self: flex-start; margin: 8px 0; }

  .viyr-ar-btn {
    margin: 4px 0 6px; padding: 12px 16px; border: none; border-radius: 10px;
    background: #111827; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer;
  }
  .viyr-ar-btn:hover { background: #1f2937; }
  .viyr-ar-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .viyr-ar-btn[hidden] { display: none; }
  .viyr-ar-note { font-size: 12px; color: #6b7280; margin: 0 0 12px; }
  .viyr-ar-note[hidden] { display: none; }

  .viyr-qr { margin-top: auto; padding-top: 16px; border-top: 1px solid #e5e7eb; }
  .viyr-qr[hidden] { display: none; }
  .viyr-qr__label { font-size: 13px; color: #374151; margin: 0 0 10px; font-weight: 600; }
  .viyr-qr__canvas { display: inline-block; line-height: 0; background: #fff; padding: 8px; border-radius: 8px; border: 1px solid #e5e7eb; }
  .viyr-qr__fallback { font-size: 12px; color: #6b7280; }
  .viyr-qr__fallback[hidden] { display: none; }

  .viyr-fit { overflow-y: auto; padding: 22px; color: #172333; }
  .viyr-fit[hidden] { display: none; }
  .viyr-fit h3 { margin: 14px 0 6px; font-size: 20px; }
  .viyr-fit p { margin: 0 0 14px; font-size: 13px; line-height: 1.45; }
  .viyr-fit label { display: flex; flex-direction: column; gap: 5px; font-size: 13px; font-weight: 600; }
  .viyr-fit input, .viyr-fit select {
    width: 100%; min-height: 40px; border: 1px solid #aab6bd; border-radius: 7px;
    padding: 8px 10px; color: #172333; background: white; font: inherit;
  }
  .viyr-fit select { max-width: 440px; margin: 6px 0 10px; }
  .viyr-fit__fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .viyr-fit__spaces { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 16px 0; }
  .viyr-fit__spaces fieldset { margin: 0; min-width: 0; padding: 12px; border: 1px solid #d9e1e5; border-radius: 8px; }
  .viyr-fit__spaces legend { padding: 0 4px; font-size: 13px; font-weight: 700; }
  .viyr-fit__spaces .viyr-fit__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .viyr-fit__result { padding: 12px; border-radius: 8px; background: #eaf2f1; font-size: 13px; line-height: 1.6; }
  .viyr-fit__result p { margin: 0 0 5px; }
  .viyr-fit__result p:last-child { margin-bottom: 0; }
  .viyr-fit__result .viyr-fit__warning { color: #9a3412; font-weight: 600; }
  .viyr-fit .viyr-fit__note { margin: 10px 0; font-size: 12px; color: #526270; }

  @media (max-width: 719px) {
    .viyr-modal__panel { width: 100vw; height: 100vh; max-height: 100vh; border-radius: 0; }
    .viyr-modal__body { min-height: 0; }
    .viyr-viewer-wrap { flex: 1 1 auto; min-height: 240px; }
    .viyr-side { order: -1; flex: 0 0 auto; padding: 16px 20px 10px; }
    .viyr-ar-btn { width: 100%; padding: 15px 16px; font-size: 16px; }
    .viyr-fit { padding: 18px; }
    .viyr-fit__spaces { grid-template-columns: 1fr; }
    .viyr-fit__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .viyr-debug { margin: 14px 0; padding: 14px; background: #0b1220; color: #d7e6ff; font: 12px/1.5 monospace; white-space: pre-wrap; word-break: break-all; max-height: 180px; overflow: auto; }
  .viyr-debug[hidden] { display: none; }
</style>

<script>
(function () {
  const VIEW_IN_YOUR_ROOM_API = "https://in-fini-homes-view-in-your-room-kindc8ae36.replit.app";

  const API_BASE = VIEW_IN_YOUR_ROOM_API.replace(/\/$/, "");
  const STOREFRONT_ENDPOINT = API_BASE + "/api/storefront/model";
  const MODEL_VIEWER_SRC = "https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js";
  const QRCODE_LIB_SRC = "https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js";

  if (window.__viyrBootstrap) {
    window.__viyrBootstrap();
    return;
  }
  function initRoot(root) {
  if (root.dataset.viyrReady) return;
  root.dataset.viyrReady = "true";

  const productHandle = root.dataset.productHandle;
  const shopStorefrontDomain = root.dataset.shopStorefrontDomain || window.location.hostname;
  const productTitle = root.dataset.productTitle || "";
  let productImageUrls = [];
  let imageParseError = "";
  try {
    const images = JSON.parse(root.dataset.productImageUrls || "[]");
    if (!Array.isArray(images)) throw new Error("Images are not an array");
    const shopifyFileRoot = "https://cdn.shopify.com/s/files/1/0625/5892/8940/";
    productImageUrls = images.map((image) => {
      const url = new URL(image, window.location.origin);
      if (url.hostname === "cdn.shopify.com" && url.protocol === "https:") return url.href;
      if ((url.hostname === shopStorefrontDomain || url.hostname === "infinihomes.shop" || url.hostname === "www.infinihomes.shop")
        && /^\/cdn\/shop\/(files|products)\//.test(url.pathname)) {
        return shopifyFileRoot + url.pathname.replace(/^\/cdn\/shop\//, "") + url.search;
      }
      throw new Error("Unsupported image host or path");
    });
  } catch (err) {
    imageParseError = String(err);
  }

  const debugPanel = new URLSearchParams(window.location.search).get("view_ar_debug") === "1"
    ? root.querySelector("[data-viyr-debug]") : null;
  const debugValues = {};
  if (debugPanel) debugPanel.hidden = false;
  function setDebug(field, value) {
    if (!debugPanel) return;
    debugValues[field] = value;
    debugPanel.textContent = "Shop: " + shopStorefrontDomain + " / " + productHandle + "\n"
      + Object.entries(debugValues).map(([key, item]) => key + ": " + item).join("\n");
  }
  setDebug("images", imageParseError || productImageUrls.length + " Shopify CDN URL(s)");

  const els = {
    button: root.querySelector("[data-viyr-open]"),
    buttonLabel: root.querySelector("[data-viyr-button-label]"),
    modal: root.querySelector("[data-viyr-modal]"),
    closeBtns: root.querySelectorAll("[data-viyr-close]"),
    viewerWrap: root.querySelector("[data-viyr-viewer-wrap]"),
    productImage: root.querySelector("[data-viyr-product-image]"),
    cameraStage: root.querySelector("[data-viyr-camera-stage]"),
    cameraImage: root.querySelector("[data-viyr-camera-image]"),
    cameraVideo: root.querySelector("[data-viyr-camera-video]"),
    cameraButton: root.querySelector("[data-viyr-start-camera]"),
    cameraRetry: root.querySelector("[data-viyr-camera-retry]"),
    cameraBack: root.querySelector("[data-viyr-stop-camera]"),
    cameraNote: root.querySelector("[data-viyr-camera-note]"),
    imageSize: root.querySelector("[data-viyr-image-size]"),
    imageSizeWrap: root.querySelector("[data-viyr-image-size-wrap]"),
    loading: root.querySelector("[data-viyr-loading]"),
    error: root.querySelector("[data-viyr-error]"),
    errorMessage: root.querySelector("[data-viyr-error-message]"),
    retry: root.querySelector("[data-viyr-retry]"),
    title: root.querySelector("[data-viyr-title]"),
    hint: root.querySelector("[data-viyr-hint]"),
    dimensions: root.querySelector("[data-viyr-dimensions]"),
    modelNotice: root.querySelector("[data-viyr-model-notice]"),
    sizeNote: root.querySelector("[data-viyr-size-note]"),
    arBtn: root.querySelector("[data-viyr-ar-btn]"),
    arNote: root.querySelector("[data-viyr-ar-note]"),
    qrBtn: root.querySelector("[data-viyr-qr-btn]"),
    qrWrap: root.querySelector("[data-viyr-qr-wrap]"),
    qrCanvas: root.querySelector("[data-viyr-qr-canvas]"),
    qrFallback: root.querySelector("[data-viyr-qr-fallback]"),
    body: root.querySelector(".viyr-modal__body"),
    fit: root.querySelector("[data-viyr-fit]"),
    fitOpen: root.querySelector("[data-viyr-size-open]"),
    fitBack: root.querySelector("[data-viyr-size-back]"),
    sizeChoice: root.querySelector("[data-viyr-size-choice]"),
    sizeSource: root.querySelector("[data-viyr-size-source]"),
    fitResult: root.querySelector("[data-viyr-fit-result]"),
  };

  let modelData = null; // populated once the backend confirms a published model
  let eligible = false;
  let availabilityChecking = true;
  let availabilityFailed = false;
  let modelViewerLoadPromise = null;
  let modelViewerEl = null;
  let viewerState = "idle"; // idle | loading | loaded | error
  let viewerTimer = null;
  let qrRequest = 0;
  let modelViewerBuildStarted = false;
  const isWardrobe = productHandle === "infini-homes-2-door-wooden-wardrobe-cabinet-cupboard-of-engineered-wood-with-1-lockable-drawer-perfect-modern-stylish-heavy-duty-color-white-without-assembly";
  const landingParams = new URLSearchParams(window.location.search);
  const imageLanding = landingParams.get("view_product_image") === "1"
    || (landingParams.get("view_dimensions") === "1" && !!productImageUrls[0]);
  let forceImageFallback = false;
  let imageFailed = false;
  let cameraStream = null;
  let cameraRequest = 0;
  let imageOffsetX = 0;
  let imageOffsetY = 0;
  let imageDrag = null;
  function useProductImage() {
    return !!productImageUrls[0] && (isWardrobe || imageLanding || forceImageFallback || !modelData);
  }
  function stopCamera() {
    cameraRequest++;
    if (cameraStream) cameraStream.getTracks().forEach((track) => track.stop());
    cameraStream = null;
    els.cameraVideo.pause();
    els.cameraVideo.srcObject = null;
    els.cameraVideo.hidden = true;
    els.cameraStage.hidden = true;
    els.cameraStage.setAttribute("aria-hidden", "true");
    els.modal.setAttribute("aria-hidden", els.modal.hidden ? "true" : "false");
    els.cameraButton.hidden = !useProductImage() || !isWardrobe || !isMobileDevice();
  }
  async function startCamera() {
    if (els.modal.hidden || !isWardrobe || !useProductImage() || !isMobileDevice()) return;
    const request = ++cameraRequest;
    els.cameraStage.hidden = false;
    els.cameraStage.setAttribute("aria-hidden", "false");
    els.modal.setAttribute("aria-hidden", "true");
    els.cameraBack.focus();
    els.cameraImage.src = productImageUrls[0];
    positionProductImage();
    els.cameraNote.textContent = "Starting camera…";
    els.cameraRetry.hidden = true;
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      els.cameraNote.textContent = "Camera unavailable here. Use a phone browser over HTTPS.";
      return;
    }
    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        audio: false, video: { facingMode: { ideal: "environment" } },
      });
      if (request !== cameraRequest || els.modal.hidden || els.cameraStage.hidden || !useProductImage()) {
        stream.getTracks().forEach((track) => track.stop());
        return;
      }
      cameraStream = stream;
      els.cameraVideo.srcObject = stream;
      els.cameraVideo.hidden = false;
      await els.cameraVideo.play();
      if (request === cameraRequest) {
        els.cameraNote.textContent = "2D visual overlay only. Drag or resize the image; placement is not measured.";
      }
    } catch (error) {
      if (request !== cameraRequest) return;
      if (cameraStream) cameraStream.getTracks().forEach((track) => track.stop());
      cameraStream = null;
      els.cameraVideo.srcObject = null;
      els.cameraVideo.hidden = true;
      els.cameraRetry.hidden = false;
      els.cameraNote.textContent = error && error.name === "NotAllowedError"
        ? "Camera permission was denied. Allow camera access in your browser."
        : "Camera could not start on this device.";
    }
  }
  function positionProductImage() {
    [els.productImage, els.cameraImage].forEach((image) => {
      image.style.setProperty("--move-x", imageOffsetX + "px");
      image.style.setProperty("--move-y", imageOffsetY + "px");
      image.style.setProperty("--size", String(Number(els.imageSize.value) / 100));
    });
  }
  function showProductImage() {
    els.loading.hidden = true;
    els.error.hidden = !imageFailed;
    els.retry.hidden = true;
    if (imageFailed) els.errorMessage.textContent = "This product image could not load. Please check its Shopify product media.";
    if (modelViewerEl) modelViewerEl.hidden = true;
    els.productImage.hidden = imageFailed;
    if (els.productImage.src !== productImageUrls[0]) els.productImage.src = productImageUrls[0];
    els.hint.hidden = false;
    els.hint.textContent = isWardrobe
      ? "White wardrobe PNG • 2D visual preview, not to scale."
      : "Product photo • 2D visual preview, not to scale.";
    els.arBtn.hidden = true;
    showArNote("");
    els.cameraButton.hidden = !isWardrobe || !isMobileDevice();
  }
  function updateButtonLabel() {
    els.buttonLabel.textContent = useProductImage()
      ? "View Product Image & Check Size"
      : modelData ? "View in Your Room & Check Size" : "Check Size & Room Fit";
  }
  let lastSizeChoice = els.sizeChoice.value;
  const sizeDrafts = new Map();
  const productFields = ["product-width", "product-depth", "product-height"];

  function fitField(name) {
    return root.querySelector("[data-viyr-" + name + "]");
  }
  function fitNumber(name, allowZero) {
    const raw = fitField(name).value.trim();
    if (!raw) return null;
    const value = Number(raw);
    return Number.isFinite(value) && value >= (allowZero ? 0 : 0.1) && value <= 100000 ? value : NaN;
  }
  function fitFormat(value) {
    return (Math.round(value * 10) / 10).toLocaleString("en-US", { maximumFractionDigits: 1 });
  }
  function fitLine(text, warning) {
    const line = document.createElement("p");
    line.textContent = text;
    if (warning) line.className = "viyr-fit__warning";
    els.fitResult.appendChild(line);
  }
  function fitClearance(label, available, occupied) {
    const remaining = available - occupied;
    fitLine(label + ": " + (remaining >= 0
      ? fitFormat(remaining) + " cm free"
      : fitFormat(-remaining) + " cm too small"), remaining < 0);
  }
  function renderFit() {
    els.fitResult.replaceChildren();
    const width = fitNumber("product-width");
    const depth = fitNumber("product-depth");
    const height = fitNumber("product-height");
    if (![width, depth, height].every((v) => v !== null && Number.isFinite(v))) {
      fitLine("Enter the product's width, depth and height in cm to calculate its space.", true);
      return;
    }
    fitLine("Product: " + fitFormat(width) + " W × " + fitFormat(depth) + " D × " + fitFormat(height) + " H cm.");
    fitLine("Floor footprint: " + fitFormat(width) + " × " + fitFormat(depth) + " cm = "
      + (width * depth / 10000).toLocaleString("en-US", { maximumFractionDigits: 2 }) + " m².");
    const wallWidth = fitNumber("wall-width");
    const wallHeight = fitNumber("wall-height");
    const floorWidth = fitNumber("floor-width");
    const floorDepth = fitNumber("floor-depth");
    const backGap = fitNumber("back-gap", true);
    if (backGap === null || !Number.isFinite(backGap)) {
      fitLine("Enter a valid gap behind the product (0 cm if placed against the wall).", true);
      return;
    }
    fitLine("Gap behind product: " + fitFormat(backGap) + " cm (entered by you).");
    const wallStarted = wallWidth !== null || wallHeight !== null;
    const floorStarted = floorWidth !== null || floorDepth !== null;
    if (wallStarted && [wallWidth, wallHeight].every((v) => v !== null && Number.isFinite(v))) {
      fitClearance("Wall width remaining (total, both sides)", wallWidth, width);
      fitClearance("Wall height remaining above product", wallHeight, height);
    } else if (wallStarted) {
      fitLine("Enter both wall width and height as valid positive numbers to see wall clearance.", true);
    }
    if (floorStarted && [floorWidth, floorDepth].every((v) => v !== null && Number.isFinite(v))) {
      fitClearance("Floor width remaining (total, both sides)", floorWidth, width);
      fitClearance("Free floor depth in front of product", floorDepth, depth + backGap);
      fitLine("Product footprint covers " + (width * depth / (floorWidth * floorDepth) * 100)
        .toLocaleString("en-US", { maximumFractionDigits: 1 }) + "% of the entered floor area.");
    } else if (floorStarted) {
      fitLine("Enter both floor width and depth as valid positive numbers to see floor clearance.", true);
    }
    if (!wallStarted && !floorStarted) fitLine("Add wall measurements, floor measurements, or both to see remaining space.");
  }
  function changeSizeChoice() {
    sizeDrafts.set(lastSizeChoice, productFields.map((field) => fitField(field).value));
    lastSizeChoice = els.sizeChoice.value;
    let values = sizeDrafts.get(lastSizeChoice) || ["", "", ""];
    if (lastSizeChoice === "model" && modelData && modelData.dimensions && !sizeDrafts.has("model")) {
      const dims = modelData.dimensions;
      values = [dims.width, dims.depth, dims.height];
    }
    productFields.forEach((field, index) => { fitField(field).value = values[index]; });
    els.sizeSource.textContent = lastSizeChoice === "model"
      ? "Reference dimensions from the approved 3D preview (not automatically valid for other variants). Edit if your selected product differs."
      : lastSizeChoice === "custom"
      ? "Custom measurements are for planning only, not a confirmed orderable size."
      : "Shopify lists this size name, but has no verified width/depth/height here. Enter its actual measurements below.";
    renderFit();
  }
  function addReferenceSize() {
    const dims = modelData && modelData.dimensions;
    if (!dims || dims.unit !== "cm" || !["width", "depth", "height"].every((key) =>
      typeof dims[key] === "number" && Number.isFinite(dims[key]) && dims[key] > 0)) return;
    if (els.sizeChoice.querySelector('[value="model"]')) return;
    const option = document.createElement("option");
    option.value = "model";
    option.textContent = "3D reference size — " + dims.width + " W × " + dims.depth + " D × " + dims.height + " H cm";
    els.sizeChoice.insertBefore(option, els.sizeChoice.firstChild);
    if (els.sizeChoice.options.length === 2 && productFields.every((field) => !fitField(field).value)) {
      els.sizeChoice.value = "model";
      changeSizeChoice();
    }
  }
  function showFitPanel() {
    els.body.hidden = true;
    els.fit.hidden = false;
    renderFit();
    els.fitBack.focus();
  }

  function loadScriptOnce(src) {
    window.__viyrScriptPromises = window.__viyrScriptPromises || {};
    if (window.__viyrScriptPromises[src]) return window.__viyrScriptPromises[src];
    const promise = new Promise((resolve, reject) => {
      const s = document.createElement("script");
      s.src = src;
      if (src === MODEL_VIEWER_SRC) s.type = "module";
      s.setAttribute("data-viyr-loaded", src);
      const timer = setTimeout(() => reject(new Error("Script loading timed out")), 12000);
      s.onload = () => { clearTimeout(timer); resolve(); };
      s.onerror = () => { clearTimeout(timer); reject(new Error("Failed to load " + src)); };
      document.head.appendChild(s);
    });
    window.__viyrScriptPromises[src] = promise.catch((err) => {
      delete window.__viyrScriptPromises[src];
      const script = document.querySelector('script[data-viyr-loaded="' + src + '"]');
      if (script) script.remove();
      throw err;
    });
    return window.__viyrScriptPromises[src];
  }

  async function fetchWithTimeout(url, options) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 10000);
    try {
      return await fetch(url, { ...options, signal: controller.signal });
    } finally {
      clearTimeout(timer);
    }
  }

  function isMobileDevice() {
    return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent)
      || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
  }
  function isIOS() {
    return /iPhone|iPad|iPod/i.test(navigator.userAgent)
      || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
  }

  async function fetchModelAvailability() {
    const url = STOREFRONT_ENDPOINT
      + "?shop=" + encodeURIComponent(shopStorefrontDomain)
      + "&product_handle=" + encodeURIComponent(productHandle);

    const res = await fetchWithTimeout(url, { headers: { Accept: "application/json" } });
    if (!res.ok) throw new Error("Storefront API returned " + res.status);
    const data = await res.json();
    if (typeof data.available !== "boolean" || typeof data.eligible !== "boolean")
      throw new Error("Storefront API must provide eligibility and model availability");
    return data;
  }

  async function initAvailability() {
    try {
      const data = await fetchModelAvailability();
      availabilityFailed = false;
      setDebug("backend", "online");
      eligible = data.eligible;
      setDebug("eligible", eligible ? "eligible" : "not in eligible catalog");
      els.button.hidden = !eligible;
      if (!eligible) {
        availabilityChecking = false;
        return;
      }
      setDebug("model", data.available ? "published" : "not available");
      if (data.available && data.modelUrl) {
        modelData = data;
        addReferenceSize();

      } else if (data.available) {
        throw new Error("Published model response has no model URL");
      }
      updateButtonLabel();
      availabilityChecking = false;
      if (root.isConnected && (imageLanding || landingParams.get("view_dimensions") === "1"
        || (modelData && landingParams.get("view_ar") === "1"))) {
        openModal();
        if (!imageLanding && landingParams.get("view_dimensions") === "1") showFitPanel();
      } else if (!els.modal.hidden && root.isConnected) openModal();
    } catch (err) {
      availabilityFailed = true;
      availabilityChecking = false;
      els.button.hidden = true;
      setDebug("backend", "offline");
      setDebug("model", "check failed: " + String(err));
      console.warn("[View in Your Room] availability check failed:", err);
      if (!els.modal.hidden) closeModal();
    }
  }

  async function ensureModelViewer() {
    if (!modelViewerLoadPromise) {
      modelViewerLoadPromise = loadScriptOnce(MODEL_VIEWER_SRC).catch((err) => {
        modelViewerLoadPromise = null; // a subsequent modal open can retry
        throw err;
      });
    }
    return modelViewerLoadPromise;
  }

  function supportsWebGL2() {
    try {
      const canvas = document.createElement("canvas");
      const gl = canvas.getContext("webgl2");
      if (!gl) return false;
      const loseContext = gl.getExtension("WEBGL_lose_context");
      if (loseContext) loseContext.loseContext();
      return true;
    } catch (_) {
      return false;
    }
  }

  function buildModelViewer() {
    const mv = document.createElement("model-viewer");
    mv.setAttribute("src", modelData.modelUrl);
    mv.setAttribute("camera-controls", "");
    mv.setAttribute("touch-action", "pan-y");
    mv.setAttribute("interaction-prompt", "auto");
    if (modelData.thumbnailUrl) mv.setAttribute("poster", modelData.thumbnailUrl);
    mv.setAttribute("shadow-intensity", "1");
    mv.setAttribute("ar", "");
    if (modelData.dimensions) mv.setAttribute("ar-scale", "fixed");
    mv.setAttribute("ar-modes", "webxr scene-viewer quick-look");
    mv.addEventListener("error", onViewerError);
    mv.addEventListener("load", onViewerLoad);
    mv.addEventListener("ar-status", (event) => {
      if (event.detail && event.detail.status === "failed" && !els.modal.hidden) {
        showArNote("AR couldn't open on this device. You can still explore the 3D model here.");
      }
    });
    return mv;
  }

  function onViewerLoad() {
    clearTimeout(viewerTimer);
    viewerState = "loaded";
    els.loading.hidden = true;
    els.error.hidden = true;
    els.retry.hidden = true;
    setupArButton();
  }

  function onViewerError() {
    clearTimeout(viewerTimer);
    viewerState = "error";
    els.loading.hidden = true;
    els.error.hidden = false;
    els.retry.hidden = false;
    els.errorMessage.textContent = "We couldn't load the 3D model right now. Please try again in a moment.";
    setupArButton();
  }

  function showArNote(message) {
    els.arNote.textContent = message;
    els.arNote.hidden = !message;
  }

  function setupArButton() {
    if (isMobileDevice()) {
      els.qrBtn.hidden = true;
      els.qrWrap.hidden = true;
      els.arBtn.hidden = viewerState === "error" || viewerState === "unsupported";
      els.arBtn.disabled = viewerState !== "loaded" || !modelViewerEl || modelViewerEl.canActivateAR !== true;
      els.arBtn.textContent = viewerState === "loading" || viewerState === "idle"
        ? "Preparing AR…" : "View in your space (AR)";
      showArNote(viewerState === "unsupported"
        ? "3D/AR needs WebGL2 enabled on this phone. Try opening this page in a supported mobile browser."
        : viewerState === "error"
        ? "AR needs the 3D model to load first. Please close and reopen to retry."
        : viewerState !== "loaded"
        ? "Loading the 3D model before AR is available."
        : els.arBtn.disabled
        ? "AR isn't supported in this browser or device. You can still explore the 3D model here."
        : isIOS()
        ? "Tap to open Apple's Quick Look. Your browser may ask for camera access."
        : "Tap to place this product in your room. Your browser may ask for camera access.");
    } else {
      els.arBtn.hidden = true;
      showArNote("");
      els.qrBtn.hidden = false;
    }
  }

  function resetQr() {
    qrRequest++;
    els.qrWrap.hidden = true;
    els.qrBtn.setAttribute("aria-expanded", "false");
    els.qrBtn.textContent = "Show QR code";
    els.qrCanvas.replaceChildren();
    els.qrFallback.hidden = true;
  }

  function selectedVariantId() {
    const fromUrl = new URLSearchParams(window.location.search).get("variant");
    if (fromUrl && /^\d+$/.test(fromUrl)) return fromUrl;
    const input = document.querySelector('form[action*="/cart/add"] [name="id"]');
    return input && /^\d+$/.test(input.value) ? input.value : "";
  }

  function productPageUrl() {
    const canonical = document.querySelector('link[rel="canonical"]');
    const candidate = canonical ? new URL(canonical.href, window.location.origin) : null;
    const path = productUrl;
    const page = candidate && candidate.protocol === "https:"
      && candidate.hostname.replace(/^www\./, "") === shopStorefrontDomain.replace(/^www\./, "")
      && candidate.pathname.replace(/\/$/, "").endsWith(path)
      ? candidate : new URL(root.dataset.productUrl || path, window.location.origin);
    page.search = "";
    page.hash = "";
    const variant = selectedVariantId();
    if (variant) page.searchParams.set("variant", variant);
    page.searchParams.set(useProductImage() ? "view_product_image" : modelData ? "view_ar" : "view_dimensions", "1");
    return page.toString();
  }

  function renderDesktopQr() {
    const request = ++qrRequest;
    const qrTarget = productPageUrl();
    const imageHandoff = new URL(qrTarget).searchParams.has("view_product_image");
    const qrLabel = els.qrWrap.querySelector(".viyr-qr__label");
    if (qrLabel) qrLabel.textContent = imageHandoff
      ? "Scan with your phone to view the product image"
      : modelData ? "Scan with your phone for AR" : "Scan with your phone to enter room dimensions";
    els.qrWrap.hidden = false;
    els.qrCanvas.replaceChildren();
    els.qrFallback.hidden = true;

    loadScriptOnce(QRCODE_LIB_SRC)
      .then(() => {
        if (request !== qrRequest || els.modal.hidden || els.qrWrap.hidden) return;
        if (!window.QRCode) throw new Error("QRCode library unavailable");
        new window.QRCode(els.qrCanvas, { text: qrTarget, width: 160, height: 160, correctLevel: window.QRCode.CorrectLevel.M });
        els.qrFallback.hidden = true;
      })
      .catch(() => {
        if (request === qrRequest && !els.modal.hidden && !els.qrWrap.hidden) showQrFallback();
      });
  }

  function showQrFallback() {
    els.qrCanvas.replaceChildren();
    els.qrFallback.hidden = false;
  }

  function renderModelDetails() {
    const dims = modelData && modelData.dimensions;
    const valid = dims && ["width", "height", "depth"].every((key) =>
      typeof dims[key] === "number" && Number.isFinite(dims[key]) && dims[key] > 0)
      && typeof dims.unit === "string" && /^[a-zA-Z]{1,12}$/.test(dims.unit);
    els.dimensions.hidden = !valid || useProductImage();
    els.dimensions.textContent = valid
      ? "Modeled preview size: " + dims.width + "W × " + dims.depth + "L × " + dims.height + "H " + dims.unit
      : "";
    const notice = modelData && typeof modelData.modelNotice === "string" ? modelData.modelNotice.trim() : "";
    els.modelNotice.textContent = notice;
    els.modelNotice.hidden = !notice || useProductImage();
    els.sizeNote.hidden = !modelData || useProductImage();
    els.sizeNote.textContent = modelData
      ? "This 3D model represents only the previewed size" + (selectedVariantId() ? ", not necessarily your selected variant" : "") + ". Other sizes are not verified or automatically scaled."
      : "";
  }

  async function openModal() {
    if (viewerState === "error" && modelViewerEl) {
      modelViewerEl.remove();
      modelViewerEl = null;
      modelViewerBuildStarted = false;
      viewerState = "idle";
    }
    els.modal.hidden = false;
    els.modal.setAttribute("aria-hidden", "false");
    if (!els.fit.hidden) return; // leave an open calculator undisturbed by API refreshes
    els.body.hidden = false;
    els.title.textContent = (modelData && modelData.title) || productTitle;
    renderModelDetails();
    els.hint.hidden = !modelData;
    els.loading.hidden = !modelData || viewerState !== "idle" && viewerState !== "loading";
    els.error.hidden = !!modelData;
    els.retry.hidden = !!modelData || availabilityChecking;
    els.arBtn.hidden = true;
    els.arNote.hidden = true;
    resetQr();
    els.qrBtn.hidden = true;
    document.body.style.overflow = "hidden";
    if (!isMobileDevice()) {
      els.qrBtn.hidden = false;
      els.qrBtn.textContent = "Hide QR code";
      els.qrBtn.setAttribute("aria-expanded", "true");
      renderDesktopQr();
    }

    if (useProductImage()) {
      showProductImage();
      return;
    }
    els.productImage.hidden = true;
    els.cameraButton.hidden = true;
    if (modelViewerEl) modelViewerEl.hidden = false;
    if (!modelData) {
      els.loading.hidden = !availabilityChecking;
      els.error.hidden = availabilityChecking;
      els.errorMessage.textContent = availabilityChecking
        ? "Checking whether this product's 3D model is ready…"
        : availabilityFailed
        ? "We can't check this product's 3D model right now. Retry the availability check."
        : "No published 3D model for this product yet. You can still enter its real dimensions and check how it fits.";
      els.qrBtn.hidden = isMobileDevice();
      return;
    }

    setupArButton();
    if (!modelViewerEl && !modelViewerBuildStarted) {
      if (!supportsWebGL2()) {
        viewerState = "unsupported";
        els.loading.hidden = true;
        els.error.hidden = false;
        els.retry.hidden = true;
        els.errorMessage.textContent = isMobileDevice()
          ? "3D/AR preview needs WebGL2 enabled on this phone. The published model is still available; try a supported mobile browser."
          : "3D preview needs WebGL2 enabled in this browser. The published model is still available; scan the QR code on a supported phone for AR.";
        setupArButton();
        return;
      }
      modelViewerBuildStarted = true;
      viewerState = "loading";
      els.loading.hidden = false;
      setupArButton();
      try {
        await ensureModelViewer();
        if (!root.isConnected) return;
        modelViewerEl = buildModelViewer();
        els.viewerWrap.appendChild(modelViewerEl);
        viewerTimer = setTimeout(() => {
          if (viewerState === "loading") {
            onViewerError();
            setDebug("model", "3D model loading timed out");
          }
        }, 20000);
      } catch (err) {
        console.warn("[View in Your Room] model-viewer failed to load:", err);
        modelViewerBuildStarted = false; // allow a retry on the next open
        onViewerError();
        return;
      }
    }
  }

  function closeModal() {
    stopCamera();
    resetQr();
    els.fit.hidden = true;
    els.body.hidden = false;
    els.modal.hidden = true;
    els.modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  els.button.addEventListener("click", openModal);
  els.fitOpen.addEventListener("click", showFitPanel);
  els.fitBack.addEventListener("click", () => {
    els.fit.hidden = true;
    els.body.hidden = false;
    openModal();
  });
  els.sizeChoice.addEventListener("change", changeSizeChoice);
  root.querySelectorAll(".viyr-fit input").forEach((field) => field.addEventListener("input", renderFit));
  els.qrBtn.addEventListener("click", () => {
    if (isMobileDevice() || els.modal.hidden) return;
    if (!els.qrWrap.hidden) {
      resetQr();
    } else {
      els.qrBtn.textContent = "Hide QR code";
      els.qrBtn.setAttribute("aria-expanded", "true");
      renderDesktopQr();
    }
  });
  els.retry.addEventListener("click", async () => {
    if (modelData) {
      openModal();
      return;
    }
    if (availabilityChecking) return;
    availabilityChecking = true;
    els.retry.hidden = true;
    els.error.hidden = true;
    els.loading.hidden = false;
    try {
      const data = await fetchModelAvailability();
      availabilityFailed = false;
      if (data.available && !data.modelUrl) throw new Error("Published model response has no model URL");
      modelData = data.available ? data : null;
      if (modelData) addReferenceSize();
      updateButtonLabel();
      setDebug("model", modelData ? "published" : "not available");
    } catch (err) {
      availabilityFailed = true;
      setDebug("model", "check failed: " + String(err));
      console.warn("[View in Your Room] availability retry failed:", err);
    } finally {
      availabilityChecking = false;
      if (!els.modal.hidden && root.isConnected) openModal();
    }
  });
  els.arBtn.addEventListener("click", () => {
    if (viewerState !== "loaded" || !modelViewerEl || modelViewerEl.canActivateAR !== true) {
      setupArButton();
      return;
    }
    try {
      showArNote("Opening AR… Your browser may ask for camera access.");
      Promise.resolve(modelViewerEl.activateAR()).catch((err) => {
        console.warn("[View in Your Room] AR launch failed:", err);
        if (!els.modal.hidden) showArNote("AR couldn't open on this device. You can still explore the 3D model here.");
      });
    } catch (err) {
      console.warn("[View in Your Room] AR launch failed:", err);
      showArNote("AR couldn't open on this device. You can still explore the 3D model here.");
    }
  });
  els.closeBtns.forEach((btn) => btn.addEventListener("click", closeModal));
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (!els.cameraStage.hidden) stopCamera();
    else if (!els.modal.hidden) closeModal();
  });

  els.productImage.addEventListener("error", () => {
    imageFailed = true;
    els.productImage.hidden = true;
    els.error.hidden = false;
    els.retry.hidden = true;
    els.errorMessage.textContent = "This product image could not load. Please check its Shopify product media.";
  });
  els.cameraButton.addEventListener("click", startCamera);
  els.cameraRetry.addEventListener("click", startCamera);
  els.cameraBack.addEventListener("click", stopCamera);
  els.imageSize.addEventListener("input", positionProductImage);
  [els.productImage, els.cameraImage].forEach((image) => {
    image.addEventListener("pointerdown", (event) => {
      if (image.hidden) return;
      imageDrag = { id: event.pointerId, x: event.clientX - imageOffsetX, y: event.clientY - imageOffsetY };
      image.setPointerCapture(event.pointerId);
    });
    image.addEventListener("pointermove", (event) => {
      if (!imageDrag || imageDrag.id !== event.pointerId) return;
      imageOffsetX = event.clientX - imageDrag.x;
      imageOffsetY = event.clientY - imageDrag.y;
      positionProductImage();
    });
    image.addEventListener("pointerup", () => { imageDrag = null; });
    image.addEventListener("pointercancel", () => { imageDrag = null; });
  });
  window.addEventListener("pagehide", stopCamera);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) stopCamera();
  });

  updateButtonLabel();
  initAvailability();
  }

  function initAll() {
    document.querySelectorAll(".viyr-root[data-viyr-instance]").forEach(initRoot);
  }
  window.__viyrBootstrap = initAll;
  document.addEventListener("shopify:section:load", initAll);
  initAll();
})();
</script>
