  .viyr-product-image{position:absolute;top:50%;left:50%;max-width:86%;max-height:86%;width:auto;height:auto;object-fit:contain;cursor:grab;touch-action:none;user-select:none;-webkit-user-drag:none;transform:translate(-50%,-50%) translate(var(--move-x,0px),var(--move-y,0px)) scale(var(--size,1));filter:drop-shadow(0 7px 8px rgba(0,0,0,.18))}
  .viyr-product-image:active{cursor:grabbing}
