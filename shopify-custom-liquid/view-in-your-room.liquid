{% comment %}
  INFini Homes — "View in Your Room" (Custom Liquid, single-file)
  =================================================================
  Paste this ENTIRE file into: Shopify Admin → Online Store → Themes →
  Customize → Product template → Add block/section → Custom Liquid → Save.

  Nothing else needs editing except the one config line below when the
  backend moves from Replit to Railway.

  What this does NOT do (by design):
  - Does not modify product images, gallery, price, variants, or Add to Cart.
  - Does not embed any Shopify or Meshy secret/token/API key.
  - Does not assume a model exists -- the backend is the sole source of
    truth for eligibility, model status, and publish state.
  - Does not fabricate a USDZ/iOS AR asset -- model-viewer generates Quick
    Look's USDZ from the actual published GLB when a supported iOS shopper
    taps AR. Camera permission and AR launch remain browser-controlled.
{% endcomment %}

<div
  class="viyr-root"
  id="viyr-root-{{ product.id }}"
  data-viyr-instance
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-type="{{ product.type | escape }}"
  data-product-vendor="{{ product.vendor | escape }}"
  data-product-url="{{ product.url }}"
  data-product-image-urls="{{ product.images | map: 'src' | json | escape }}"
  data-shop-domain="{{ shop.permanent_domain }}"
  data-shop-storefront-domain="{{ request.host }}"
>
  <button type="button" class="viyr-button" data-viyr-open hidden>
    <svg class="viyr-button__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path fill="currentColor" d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3 6.5 3.6-6.5 3.6-6.5-3.6L12 4.3ZM5 9.6l6 3.3v7.1l-6-3.3V9.6Zm8 10.4v-7.1l6-3.3v7.1l-6 3.3Z"/>
    </svg>
    <span>View in Your Room</span>
  </button>

  <div class="viyr-modal" data-viyr-modal hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="View in Your Room">
    <div class="viyr-modal__backdrop" data-viyr-close></div>
    <div class="viyr-modal__panel">
      <button type="button" class="viyr-modal__close" data-viyr-close aria-label="Close">&times;</button>

      <div class="viyr-modal__body">
        <div class="viyr-viewer-wrap" data-viyr-viewer-wrap>
          <div class="viyr-state viyr-state--loading" data-viyr-loading>
            <div class="viyr-spinner" aria-hidden="true"></div>
            <p>Loading 3D model…</p>
          </div>
          <div class="viyr-state viyr-state--error" data-viyr-error hidden>
            <p data-viyr-error-message>We couldn't load the 3D model right now. Please try again in a moment.</p>
          </div>
          <!-- <model-viewer> is inserted here by JS once the script has loaded and a model is confirmed available. -->
        </div>

        <div class="viyr-side">
          <h3 class="viyr-side__title" data-viyr-title>&nbsp;</h3>
          <p class="viyr-side__hint" data-viyr-hint>Drag to rotate &middot; Pinch or scroll to zoom</p>

          <button type="button" class="viyr-ar-btn" data-viyr-ar-btn hidden disabled>
            View in your space (AR)
          </button>
          <p class="viyr-ar-note" data-viyr-ar-note hidden role="status" aria-live="polite"></p>

          <div class="viyr-qr" data-viyr-qr-wrap hidden>
            <p class="viyr-qr__label">Scan with your phone for AR</p>
            <div data-viyr-qr-canvas class="viyr-qr__canvas"></div>
            <p class="viyr-qr__fallback" data-viyr-qr-fallback hidden>
              QR code unavailable — open this page on your phone instead.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Diagnostic panel: only ever shown when the page URL has ?view_ar_debug=1.
       No secret, token, or credential is ever placed in this markup or the
       script that fills it in -- only shop/product identifiers and status
       words. -->
  <div class="viyr-debug" data-viyr-debug hidden>
    <div class="viyr-debug__title">View in Your Room — Debug</div>
    <div class="viyr-debug__row"><span>Shop</span><span data-viyr-debug-shop>—</span></div>
    <div class="viyr-debug__row"><span>Backend</span><span data-viyr-debug-backend>—</span></div>
    <div class="viyr-debug__row"><span>Product connect</span><span data-viyr-debug-connect>—</span></div>
    <div class="viyr-debug__row"><span>Eligibility</span><span data-viyr-debug-eligible>—</span></div>
    <div class="viyr-debug__row"><span>Model status</span><span data-viyr-debug-model>—</span></div>
    <div class="viyr-debug__row"><span>Images</span><span data-viyr-debug-images>—</span></div>
    <div class="viyr-debug__row"><span>Last API response</span></div>
    <pre data-viyr-debug-response>—</pre>
  </div>
</div>

<style>
  /* Isolated namespace: every rule is scoped under .viyr-*, nothing here
     targets Shopify theme elements (body, html, h1, button, img, etc.)
     directly, so it cannot bleed into the rest of the theme. */
  .viyr-root { all: initial; display: block; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  .viyr-root *, .viyr-root *::before, .viyr-root *::after { box-sizing: border-box; }

  .viyr-button {
    display: inline-flex; align-items: center; gap: 8px;
    margin: 12px 0; padding: 12px 20px;
    background: #111827; color: #ffffff; border: none; border-radius: 999px;
    font-size: 15px; font-weight: 600; line-height: 1; cursor: pointer;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }
  .viyr-button:hover { background: #1f2937; }
  .viyr-button:active { transform: scale(0.98); }
  .viyr-button[hidden] { display: none; }
  .viyr-button__icon { flex: none; }

  .viyr-modal {
    position: fixed; inset: 0; z-index: 2147483000;
    display: flex; align-items: center; justify-content: center;
  }
  .viyr-modal[hidden] { display: none; }
  .viyr-modal__backdrop {
    position: absolute; inset: 0; background: rgba(17, 24, 39, 0.6);
  }
  .viyr-modal__panel {
    position: relative; z-index: 1;
    width: min(920px, 94vw); max-height: 90vh; overflow: hidden;
    background: #ffffff; border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    display: flex; flex-direction: column;
  }
  .viyr-modal__close {
    position: absolute; top: 10px; right: 12px; z-index: 2;
    width: 36px; height: 36px; border-radius: 999px; border: none;
    background: rgba(255,255,255,0.9); color: #111827;
    font-size: 22px; line-height: 1; cursor: pointer;
  }
  .viyr-modal__body {
    display: flex; flex-direction: column; height: 100%;
  }
  @media (min-width: 720px) {
    .viyr-modal__body { flex-direction: row; }
  }

  .viyr-viewer-wrap {
    position: relative; flex: 1 1 60%;
    min-height: 320px; background: #f3f4f6;
  }
  .viyr-viewer-wrap model-viewer { width: 100%; height: 100%; min-height: 320px; --poster-color: transparent; }

  .viyr-state {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 10px;
    color: #4b5563; font-size: 14px; text-align: center; padding: 20px;
  }
  .viyr-state[hidden] { display: none; }
  .viyr-spinner {
    width: 32px; height: 32px; border-radius: 999px;
    border: 3px solid #e5e7eb; border-top-color: #111827;
    animation: viyr-spin 0.8s linear infinite;
  }
  @keyframes viyr-spin { to { transform: rotate(360deg); } }

  .viyr-side {
    flex: 1 1 40%; padding: 20px 24px 24px; overflow-y: auto;
    display: flex; flex-direction: column;
  }
  .viyr-side__title { margin: 0 0 4px; font-size: 18px; font-weight: 700; color: #111827; }
  .viyr-side__hint { margin: 0 0 16px; font-size: 13px; color: #6b7280; }

  .viyr-ar-btn {
    margin: 4px 0 6px; padding: 12px 16px; border: none; border-radius: 10px;
    background: #111827; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer;
  }
  .viyr-ar-btn:hover { background: #1f2937; }
  .viyr-ar-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .viyr-ar-btn[hidden] { display: none; }
  .viyr-ar-note { font-size: 12px; color: #6b7280; margin: 0 0 12px; }
  .viyr-ar-note[hidden] { display: none; }

  .viyr-qr { margin-top: auto; padding-top: 16px; border-top: 1px solid #e5e7eb; }
  .viyr-qr[hidden] { display: none; }
  .viyr-qr__label { font-size: 13px; color: #374151; margin: 0 0 10px; font-weight: 600; }
  .viyr-qr__canvas { display: inline-block; line-height: 0; background: #fff; padding: 8px; border-radius: 8px; border: 1px solid #e5e7eb; }
  .viyr-qr__fallback { font-size: 12px; color: #6b7280; }
  .viyr-qr__fallback[hidden] { display: none; }

  @media (max-width: 719px) {
    .viyr-modal__panel { width: 100vw; height: 100vh; max-height: 100vh; border-radius: 0; }
    .viyr-modal__body { min-height: 0; }
    .viyr-viewer-wrap { flex: 1 1 auto; min-height: 240px; }
    .viyr-side { order: -1; flex: 0 0 auto; padding: 16px 20px 10px; }
    .viyr-ar-btn { width: 100%; padding: 15px 16px; font-size: 16px; }
  }

  .viyr-debug {
    margin: 14px 0; padding: 14px 16px; border-radius: 10px;
    background: #0b1220; color: #d7e6ff; font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    max-width: 480px;
  }
  .viyr-debug[hidden] { display: none; }
  .viyr-debug__title { font-weight: 700; margin-bottom: 8px; color: #ffffff; }
  .viyr-debug__row { display: flex; justify-content: space-between; gap: 12px; padding: 3px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .viyr-debug__row span:first-child { color: #93a4c3; }
  .viyr-debug pre { white-space: pre-wrap; word-break: break-all; margin: 6px 0 0; max-height: 160px; overflow: auto; background: rgba(255,255,255,0.06); padding: 8px; border-radius: 6px; }
</style>

<script>
(function () {
  // =========================================================================
  // SINGLE CONFIGURATION VALUE — this is the only thing to change when the
  // backend moves from Replit to Railway (or any other host). Everything
  // else in this file adapts automatically.
  // =========================================================================
  const VIEW_IN_YOUR_ROOM_API = "https://in-fini-homes-view-in-your-room.replit.app";
  // =========================================================================

  const API_BASE = VIEW_IN_YOUR_ROOM_API.replace(/\/$/, "");
  const STOREFRONT_ENDPOINT = API_BASE + "/api/storefront/model";
  const CONNECT_ENDPOINT = API_BASE + "/api/storefront/connect";
  const MODEL_VIEWER_SRC = "https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js";
  // The former qrcode/build URL was HTTP 404; qrcodejs is a classic script.
  const QRCODE_LIB_SRC = "https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js";

  // The global bootstrap survives Shopify's section replacement. Each new
  // DOM root gets its own handlers; existing roots are never initialized twice.
  if (window.__viyrBootstrap) {
    window.__viyrBootstrap();
    return;
  }
  function initRoot(root) {
  if (root.dataset.viyrReady) return;
  root.dataset.viyrReady = "true";

  const productHandle = root.dataset.productHandle;
  const shopStorefrontDomain = root.dataset.shopStorefrontDomain || window.location.hostname;
  const productId = root.dataset.productId || "";
  const productTitle = root.dataset.productTitle || "";
  const productType = root.dataset.productType || "";
  const productVendor = root.dataset.productVendor || "";
  // product.url without `within: collection` always points to /products/...
  const productUrl = "/products/" + encodeURIComponent(productHandle);
  let productImageUrls = [];
  let imageParseError = "";
  try {
    const images = JSON.parse(root.dataset.productImageUrls || "[]");
    if (!Array.isArray(images)) throw new Error("Images are not an array");
    // Liquid's image.src on the live store resolves to
    // //infinihomes.shop/cdn/shop/files/..., while /connect accepts only
    // absolute https://cdn.shopify.com URLs. The CDN file root below is
    // verified against this shop's public /products.json images.
    const shopifyFileRoot = "https://cdn.shopify.com/s/files/1/0625/5892/8940/";
    productImageUrls = images.map((image) => {
      const url = new URL(image, window.location.origin);
      if (url.hostname === "cdn.shopify.com" && url.protocol === "https:") return url.href;
      if ((url.hostname === shopStorefrontDomain || url.hostname === "infinihomes.shop" || url.hostname === "www.infinihomes.shop")
        && /^\/cdn\/shop\/(files|products)\//.test(url.pathname)) {
        return shopifyFileRoot + url.pathname.replace(/^\/cdn\/shop\//, "") + url.search;
      }
      throw new Error("Unsupported image host or path");
    });
  } catch (err) {
    imageParseError = String(err);
  }

  // Diagnostic panel: only ever activated by ?view_ar_debug=1. Nothing here
  // reads or displays a secret -- only shop/product identifiers and status
  // words already safe to show a merchant testing the integration.
  const debugEnabled = new URLSearchParams(window.location.search).get("view_ar_debug") === "1";
  const debugEls = debugEnabled
    ? {
        panel: root.querySelector("[data-viyr-debug]"),
        shop: root.querySelector("[data-viyr-debug-shop]"),
        backend: root.querySelector("[data-viyr-debug-backend]"),
        connect: root.querySelector("[data-viyr-debug-connect]"),
        eligible: root.querySelector("[data-viyr-debug-eligible]"),
        model: root.querySelector("[data-viyr-debug-model]"),
        images: root.querySelector("[data-viyr-debug-images]"),
        response: root.querySelector("[data-viyr-debug-response]"),
      }
    : null;
  if (debugEls && debugEls.panel) {
    debugEls.panel.hidden = false;
    if (debugEls.shop) debugEls.shop.textContent = shopStorefrontDomain + " / " + productHandle;
  }
  function setDebug(field, value) {
    if (debugEls && debugEls[field]) debugEls[field].textContent = value;
  }
  setDebug("images", imageParseError || productImageUrls.length + " Shopify CDN URL(s)");

  const els = {
    button: root.querySelector("[data-viyr-open]"),
    modal: root.querySelector("[data-viyr-modal]"),
    closeBtns: root.querySelectorAll("[data-viyr-close]"),
    viewerWrap: root.querySelector("[data-viyr-viewer-wrap]"),
    loading: root.querySelector("[data-viyr-loading]"),
    error: root.querySelector("[data-viyr-error]"),
    errorMessage: root.querySelector("[data-viyr-error-message]"),
    title: root.querySelector("[data-viyr-title]"),
    hint: root.querySelector("[data-viyr-hint]"),
    arBtn: root.querySelector("[data-viyr-ar-btn]"),
    arNote: root.querySelector("[data-viyr-ar-note]"),
    qrWrap: root.querySelector("[data-viyr-qr-wrap]"),
    qrCanvas: root.querySelector("[data-viyr-qr-canvas]"),
    qrFallback: root.querySelector("[data-viyr-qr-fallback]"),
  };

  let modelData = null; // populated once the backend confirms a published model
  let eligible = false;
  let availabilityChecking = true;
  let availabilityFailed = false;
  let modelViewerLoadPromise = null;
  let modelViewerEl = null;
  let viewerState = "idle"; // idle | loading | loaded | error
  let viewerTimer = null;
  // Set synchronously (before the first `await` in openModal) so a burst of
  // rapid clicks -- which all run their synchronous prelude before any of
  // them resumes after `await ensureModelViewer()` -- can't all see
  // `modelViewerEl` as still null and each build their own <model-viewer>.
  let modelViewerBuildStarted = false;

  function loadScriptOnce(src) {
    window.__viyrScriptPromises = window.__viyrScriptPromises || {};
    if (window.__viyrScriptPromises[src]) return window.__viyrScriptPromises[src];
    const promise = new Promise((resolve, reject) => {
      const s = document.createElement("script");
      s.src = src;
      if (src === MODEL_VIEWER_SRC) s.type = "module";
      s.setAttribute("data-viyr-loaded", src);
      const timer = setTimeout(() => reject(new Error("Script loading timed out")), 12000);
      s.onload = () => { clearTimeout(timer); resolve(); };
      s.onerror = () => { clearTimeout(timer); reject(new Error("Failed to load " + src)); };
      document.head.appendChild(s);
    });
    window.__viyrScriptPromises[src] = promise.catch((err) => {
      delete window.__viyrScriptPromises[src];
      const script = document.querySelector('script[data-viyr-loaded="' + src + '"]');
      if (script) script.remove();
      throw err;
    });
    return window.__viyrScriptPromises[src];
  }

  async function fetchWithTimeout(url, options) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 10000);
    try {
      return await fetch(url, { ...options, signal: controller.signal });
    } finally {
      clearTimeout(timer);
    }
  }

  function isMobileDevice() {
    return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  }
  function isIOS() {
    return /iPhone|iPad|iPod/i.test(navigator.userAgent);
  }

  async function fetchModelAvailability() {
    const url = STOREFRONT_ENDPOINT
      + "?shop=" + encodeURIComponent(shopStorefrontDomain)
      + "&product_handle=" + encodeURIComponent(productHandle);

    const res = await fetchWithTimeout(url, { headers: { Accept: "application/json" } });
    if (!res.ok) throw new Error("Storefront API returned " + res.status);
    const data = await res.json();
    if (typeof data.available !== "boolean") throw new Error("Invalid storefront API response");
    return data;
  }

  // Registers/refreshes this product with the backend so it shows up in the
  // admin dashboard's review pipeline -- no Shopify OAuth involved, only the
  // public fields already rendered into this page by Liquid. A failure here
  // never blocks the model-availability check right after it: a product
  // that was already connected on an earlier page view can still have a
  // published model worth showing even if this particular connect call
  // fails (e.g. a transient network error).
  async function connectProduct() {
    if (!productId || !productHandle || !productImageUrls.length || imageParseError) {
      setDebug("connect", imageParseError || "skipped (missing product data)");
      return null;
    }
    try {
      const res = await fetchWithTimeout(CONNECT_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          shop: shopStorefrontDomain,
          productId: productId,
          handle: productHandle,
          title: productTitle,
          productType: productType,
          vendor: productVendor,
          productUrl: productUrl,
          imageUrls: productImageUrls,
        }),
      });
      const data = await res.json().catch(() => null);
      setDebug("backend", res.ok ? "online" : "error (" + res.status + ")");
      setDebug("connect", res.ok && data ? data.status : "failed (" + res.status + ")");
      setDebug(
        "eligible",
        data && typeof data.eligible === "boolean" ? (data.eligible ? "eligible" : "not eligible") : "unknown",
      );
      setDebug("response", JSON.stringify(data, null, 2));
      if (!res.ok) {
        console.warn("[View in Your Room] connect rejected:", res.status, data && data.error);
        return null;
      }
      return data;
    } catch (err) {
      setDebug("backend", "offline");
      setDebug("connect", "failed");
      setDebug("response", String(err));
      console.warn("[View in Your Room] connect failed:", err);
      return null;
    }
  }

  async function initAvailability() {
    const connection = await connectProduct();
    if (connection && connection.eligible === true) {
      eligible = true;
      els.button.hidden = false;
    }
    try {
      const data = await fetchModelAvailability();
      availabilityFailed = false;
      setDebug("backend", "online");
      setDebug("model", data.available ? "published" : "not available");
      if (data.available && data.modelUrl) {
        modelData = data;
        els.button.hidden = false;

      } else if (data.available) {
        throw new Error("Published model response has no model URL");
      }
      availabilityChecking = false;
      // QR links can open the 3D modal, never AR/camera without a user tap.
      if ((!els.modal.hidden || (modelData && new URLSearchParams(window.location.search).get("view_ar") === "1"))
        && root.isConnected) openModal();
    } catch (err) {
      // A confirmed eligible product retains its button. Never claim a model
      // is ready when the availability request failed.
      availabilityFailed = true;
      availabilityChecking = false;
      setDebug("backend", "offline");
      setDebug("model", "check failed: " + String(err));
      console.warn("[View in Your Room] availability check failed:", err);
      if (!els.modal.hidden && root.isConnected) openModal();
    }
  }

  async function ensureModelViewer() {
    if (!modelViewerLoadPromise) {
      modelViewerLoadPromise = loadScriptOnce(MODEL_VIEWER_SRC).catch((err) => {
        modelViewerLoadPromise = null; // a subsequent modal open can retry
        throw err;
      });
    }
    return modelViewerLoadPromise;
  }

  function buildModelViewer() {
    const mv = document.createElement("model-viewer");
    mv.setAttribute("src", modelData.modelUrl);
    mv.setAttribute("camera-controls", "");
    mv.setAttribute("touch-action", "pan-y");
    mv.setAttribute("interaction-prompt", "auto");
    if (modelData.thumbnailUrl) mv.setAttribute("poster", modelData.thumbnailUrl);
    mv.setAttribute("shadow-intensity", "1");
    // With no ios-src, model-viewer 3.5 generates a USDZ for Quick Look
    // from this *published GLB* on supported iOS devices. No fake asset URL.
    mv.setAttribute("ar", "");
    mv.setAttribute("ar-modes", "webxr scene-viewer quick-look");
    mv.addEventListener("error", onViewerError);
    mv.addEventListener("load", onViewerLoad);
    mv.addEventListener("ar-status", (event) => {
      if (event.detail && event.detail.status === "failed" && !els.modal.hidden) {
        showArNote("AR couldn't open on this device. You can still explore the 3D model here.");
      }
    });
    return mv;
  }

  function onViewerLoad() {
    clearTimeout(viewerTimer);
    viewerState = "loaded";
    els.loading.hidden = true;
    els.error.hidden = true;
    setupArButton();
  }

  function onViewerError() {
    clearTimeout(viewerTimer);
    viewerState = "error";
    els.loading.hidden = true;
    els.error.hidden = false;
    els.errorMessage.textContent = "We couldn't load the 3D model right now. Please try again in a moment.";
    setupArButton();
  }

  function showArNote(message) {
    els.arNote.textContent = message;
    els.arNote.hidden = !message;
  }

  function setupArButton() {
    if (isMobileDevice()) {
      els.qrWrap.hidden = true;
      els.arBtn.hidden = viewerState === "error";
      els.arBtn.disabled = viewerState !== "loaded" || !modelViewerEl || modelViewerEl.canActivateAR !== true;
      els.arBtn.textContent = viewerState === "loading" || viewerState === "idle"
        ? "Preparing AR…" : "View in your space (AR)";
      showArNote(viewerState === "error"
        ? "AR needs the 3D model to load first. Please close and reopen to retry."
        : viewerState !== "loaded"
        ? "Loading the 3D model before AR is available."
        : els.arBtn.disabled
        ? "AR isn't supported in this browser or device. You can still explore the 3D model here."
        : isIOS()
        ? "Tap to open Apple's Quick Look. Your browser may ask for camera access."
        : "Tap to place this product in your room. Your browser may ask for camera access.");
    } else {
      // Desktop: no in-page AR is possible, so show a QR code the shopper
      // scans to continue on their phone.
      els.arBtn.hidden = true;
      showArNote("");
      renderDesktopQr();
    }
  }

  function renderDesktopQr() {
    const productUrl = new URL(window.location.href);
    productUrl.searchParams.set("view_ar", "1");
    productUrl.searchParams.delete("view_ar_debug");
    const qrTarget = productUrl.toString();

    loadScriptOnce(QRCODE_LIB_SRC)
      .then(() => {
        if (!window.QRCode) throw new Error("QRCode library unavailable");
        els.qrCanvas.replaceChildren();
        new window.QRCode(els.qrCanvas, { text: qrTarget, width: 160, height: 160, correctLevel: window.QRCode.CorrectLevel.M });
        els.qrFallback.hidden = true;
        els.qrWrap.hidden = false;
      })
      .catch(() => showQrFallback());
  }

  function showQrFallback() {
    els.qrWrap.hidden = false;
    els.qrCanvas.innerHTML = "";
    els.qrFallback.hidden = false;
  }

  async function openModal() {
    if (!modelData && !eligible) return;

    if (viewerState === "error" && modelViewerEl) {
      modelViewerEl.remove();
      modelViewerEl = null;
      modelViewerBuildStarted = false;
      viewerState = "idle";
    }
    els.modal.hidden = false;
    els.modal.setAttribute("aria-hidden", "false");
    els.title.textContent = (modelData && modelData.title) || productTitle;
    els.hint.hidden = !modelData;
    els.loading.hidden = !modelData || viewerState !== "idle" && viewerState !== "loading";
    els.error.hidden = !!modelData;
    els.arBtn.hidden = true;
    els.arNote.hidden = true;
    els.qrWrap.hidden = true;
    document.body.style.overflow = "hidden";

    if (!modelData) {
      els.errorMessage.textContent = availabilityChecking
        ? "Checking whether this product's 3D model is ready…"
        : availabilityFailed
        ? "We can't check this product's 3D model right now. Please try again later."
        : "The 3D model for this product isn't ready yet. Please check back soon.";
      return;
    }

    setupArButton();
    if (!modelViewerEl && !modelViewerBuildStarted) {
      modelViewerBuildStarted = true;
      viewerState = "loading";
      els.loading.hidden = false;
      setupArButton();
      try {
        await ensureModelViewer();
        if (!root.isConnected) return;
        modelViewerEl = buildModelViewer();
        els.viewerWrap.appendChild(modelViewerEl);
        viewerTimer = setTimeout(() => {
          if (viewerState === "loading") {
            onViewerError();
            setDebug("model", "3D model loading timed out");
          }
        }, 20000);
      } catch (err) {
        console.warn("[View in Your Room] model-viewer failed to load:", err);
        modelViewerBuildStarted = false; // allow a retry on the next open
        onViewerError();
        return;
      }
    }
  }

  function closeModal() {
    els.modal.hidden = true;
    els.modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  els.button.addEventListener("click", openModal);
  els.arBtn.addEventListener("click", () => {
    // activateAR must be called directly in this user gesture, not after an
    // await, fetch, timer, modal auto-open, or a programmatic camera request.
    if (viewerState !== "loaded" || !modelViewerEl || modelViewerEl.canActivateAR !== true) {
      setupArButton();
      return;
    }
    try {
      showArNote("Opening AR… Your browser may ask for camera access.");
      Promise.resolve(modelViewerEl.activateAR()).catch((err) => {
        console.warn("[View in Your Room] AR launch failed:", err);
        if (!els.modal.hidden) showArNote("AR couldn't open on this device. You can still explore the 3D model here.");
      });
    } catch (err) {
      console.warn("[View in Your Room] AR launch failed:", err);
      showArNote("AR couldn't open on this device. You can still explore the 3D model here.");
    }
  });
  els.closeBtns.forEach((btn) => btn.addEventListener("click", closeModal));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !els.modal.hidden) closeModal();
  });

  initAvailability();
  }

  function initAll() {
    document.querySelectorAll(".viyr-root[data-viyr-instance]").forEach(initRoot);
  }
  window.__viyrBootstrap = initAll;
  document.addEventListener("shopify:section:load", initAll);
  initAll();
})();
</script>
